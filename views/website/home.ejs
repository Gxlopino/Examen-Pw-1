<!-- views/website/home.ejs -->

<% layout("layouts/website") %>


<!-- =========================================================
     HERO PRINCIPAL
========================================================= -->

<section class="hero-section bg-dark text-white position-relative overflow-hidden">

  <!-- Decoración -->
  <div class="hero-decoration hero-decoration-one"></div>
  <div class="hero-decoration hero-decoration-two"></div>


  <div class="container position-relative">

    <div class="row align-items-center min-vh-75 py-5">

      <!-- Contenido principal -->
      <div class="col-lg-7 py-5">

        <span class="badge bg-success px-3 py-2 mb-4">
          <i class="fa-solid fa-graduation-cap me-2"></i>
          TALENTO UNIVERSITARIO
        </span>


        <h1 class="display-3 fw-bold lh-sm mb-4">

          Encuentra la práctica
          <span class="text-success">
            que impulsa tu futuro
          </span>

        </h1>


        <p class="lead text-light mb-4">

          Conecta con empresas, descubre oportunidades
          profesionales y empieza a construir tu experiencia
          laboral desde la Universidad de Lima.

        </p>


        <div class="d-flex flex-wrap gap-3">

          <a
            href="/convocatorias"
            class="btn btn-success btn-lg px-4">

            <i class="fa-solid fa-magnifying-glass me-2"></i>
            Explorar convocatorias

          </a>


          <a
            href="/como-funciona"
            class="btn btn-outline-light btn-lg px-4">

            <i class="fa-solid fa-circle-question me-2"></i>
            ¿Cómo funciona?

          </a>

        </div>


        <!-- Indicadores -->
        <div class="row g-4 mt-5">

          <div class="col-6 col-md-4">

            <div class="d-flex align-items-center">

              <i class="fa-solid fa-building text-success fs-3 me-3"></i>

              <div>
                <h5 class="fw-bold mb-0">
                  Empresas
                </h5>

                <small class="text-secondary">
                  Oportunidades reales
                </small>
              </div>

            </div>

          </div>


          <div class="col-6 col-md-4">

            <div class="d-flex align-items-center">

              <i class="fa-solid fa-file-circle-check text-success fs-3 me-3"></i>

              <div>
                <h5 class="fw-bold mb-0">
                  Convocatorias
                </h5>

                <small class="text-secondary">
                  Prácticas disponibles
                </small>
              </div>

            </div>

          </div>


          <div class="col-6 col-md-4">

            <div class="d-flex align-items-center">

              <i class="fa-solid fa-user-graduate text-success fs-3 me-3"></i>

              <div>
                <h5 class="fw-bold mb-0">
                  Estudiantes
                </h5>

                <small class="text-secondary">
                  Talento universitario
                </small>
              </div>

            </div>

          </div>

        </div>

      </div>


      <!-- Tarjeta visual -->
      <div class="col-lg-5 d-none d-lg-block">

        <div class="hero-card shadow-lg">

          <div class="d-flex align-items-center mb-4">

            <div class="hero-icon me-3">
              <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <div>
              <h5 class="fw-bold mb-1">
                Practica Ulima
              </h5>

              <small class="text-secondary">
                Tu próximo paso profesional
              </small>
            </div>

          </div>


          <div class="hero-search mb-3">

            <i class="fa-solid fa-magnifying-glass text-secondary"></i>

            <span>
              Buscar prácticas...
            </span>

          </div>


          <div class="hero-opportunity mb-3">

            <div class="d-flex justify-content-between align-items-start">

              <div>
                <span class="badge bg-success-subtle text-success mb-2">
                  Práctica pre-profesional
                </span>

                <h6 class="fw-bold mb-1">
                  Analista de Datos
                </h6>

                <small class="text-secondary">
                  <i class="fa-solid fa-building me-1"></i>
                  Empresa destacada
                </small>
              </div>

              <i class="fa-regular fa-bookmark text-secondary"></i>

            </div>

            <hr class="border-secondary opacity-25">

            <div class="d-flex flex-wrap gap-3 text-secondary small">

              <span>
                <i class="fa-solid fa-location-dot me-1"></i>
                Lima
              </span>

              <span>
                <i class="fa-solid fa-clock me-1"></i>
                Part time
              </span>

            </div>

          </div>


          <div class="hero-opportunity">

            <div class="d-flex justify-content-between align-items-start">

              <div>
                <span class="badge bg-success-subtle text-success mb-2">
                  Nueva convocatoria
                </span>

                <h6 class="fw-bold mb-1">
                  Practicante de Marketing
                </h6>

                <small class="text-secondary">
                  <i class="fa-solid fa-building me-1"></i>
                  Empresa privada
                </small>
              </div>

              <i class="fa-regular fa-bookmark text-secondary"></i>

            </div>

            <hr class="border-secondary opacity-25">

            <div class="d-flex flex-wrap gap-3 text-secondary small">

              <span>
                <i class="fa-solid fa-location-dot me-1"></i>
                Lima
              </span>

              <span>
                <i class="fa-solid fa-clock me-1"></i>
                Híbrido
              </span>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     BUSCADOR RÁPIDO
========================================================= -->

<section class="search-section py-5">

  <div class="container">

    <div class="text-center mb-4">

      <span class="text-success fw-bold text-uppercase">
        Encuentra tu oportunidad
      </span>

      <h2 class="fw-bold mt-2">
        Busca prácticas según tus intereses
      </h2>

      <p class="text-muted mb-0">
        Explora convocatorias y encuentra una oportunidad
        que se adapte a tu perfil profesional.
      </p>

    </div>


    <div class="card border-0 shadow-sm search-card">

      <div class="card-body p-4">

        <form
          action="/convocatorias"
          method="GET">

          <div class="row g-3 align-items-end">

            <!-- Búsqueda -->
            <div class="col-12 col-lg-5">

              <label class="form-label fw-semibold">
                ¿Qué práctica estás buscando?
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="fa-solid fa-magnifying-glass text-success"></i>
                </span>

                <input
                  type="text"
                  name="search"
                  class="form-control"
                  placeholder="Ej. Marketing, Finanzas, Sistemas...">

              </div>

            </div>


            <!-- Modalidad -->
            <div class="col-12 col-md-6 col-lg-3">

              <label class="form-label fw-semibold">
                Modalidad
              </label>

              <select
                name="modality"
                class="form-select">

                <option value="">
                  Todas las modalidades
                </option>

                <option value="presencial">
                  Presencial
                </option>

                <option value="remoto">
                  Remoto
                </option>

                <option value="hibrido">
                  Híbrido
                </option>

              </select>

            </div>


            <!-- Jornada -->
            <div class="col-12 col-md-6 col-lg-2">

              <label class="form-label fw-semibold">
                Jornada
              </label>

              <select
                name="workday"
                class="form-select">

                <option value="">
                  Todas
                </option>

                <option value="part-time">
                  Part time
                </option>

                <option value="full-time">
                  Full time
                </option>

              </select>

            </div>


            <!-- Botón -->
            <div class="col-12 col-lg-2">

              <button
                type="submit"
                class="btn btn-success w-100">

                <i class="fa-solid fa-search me-2"></i>
                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     BENEFICIOS
========================================================= -->

<section class="py-5 bg-light">

  <div class="container">

    <div class="text-center mb-5">

      <span class="text-success fw-bold text-uppercase">
        Todo en un solo lugar
      </span>

      <h2 class="fw-bold mt-2">
        Una plataforma pensada para ti
      </h2>

      <p class="text-muted">
        Conoce las herramientas que te ayudarán a dar el siguiente paso.
      </p>

    </div>


    <div class="row g-4">

      <!-- Beneficio 1 -->
      <div class="col-12 col-md-6 col-lg-3">

        <div class="card benefit-card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="benefit-icon bg-success-subtle text-success mb-4">
              <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <h5 class="fw-bold">
              Busca oportunidades
            </h5>

            <p class="text-muted mb-0">
              Encuentra convocatorias de distintas áreas,
              empresas y modalidades.
            </p>

          </div>

        </div>

      </div>


      <!-- Beneficio 2 -->
      <div class="col-12 col-md-6 col-lg-3">

        <div class="card benefit-card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="benefit-icon bg-primary-subtle text-primary mb-4">
              <i class="fa-solid fa-file-circle-check"></i>
            </div>

            <h5 class="fw-bold">
              Postula fácilmente
            </h5>

            <p class="text-muted mb-0">
              Envía tus postulaciones y realiza seguimiento
              de cada proceso.
            </p>

          </div>

        </div>

      </div>


      <!-- Beneficio 3 -->
      <div class="col-12 col-md-6 col-lg-3">

        <div class="card benefit-card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="benefit-icon bg-warning-subtle text-warning mb-4">
              <i class="fa-solid fa-user-graduate"></i>
            </div>

            <h5 class="fw-bold">
              Mejora tu perfil
            </h5>

            <p class="text-muted mb-0">
              Presenta tus habilidades, experiencias y
              formación académica.
            </p>

          </div>

        </div>

      </div>


      <!-- Beneficio 4 -->
      <div class="col-12 col-md-6 col-lg-3">

        <div class="card benefit-card border-0 shadow-sm h-100">

          <div class="card-body p-4">

            <div class="benefit-icon bg-danger-subtle text-danger mb-4">
              <i class="fa-solid fa-building"></i>
            </div>

            <h5 class="fw-bold">
              Conecta con empresas
            </h5>

            <p class="text-muted mb-0">
              Conoce organizaciones que buscan talento
              universitario.
            </p>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     ESTADÍSTICAS
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="row g-4">

      <div class="col-6 col-lg-3">

        <div class="text-center">

          <i class="fa-solid fa-building text-success fs-1 mb-3"></i>

          <h2 class="fw-bold mb-1">
            <%= typeof enterpriseCount !== 'undefined'
              ? enterpriseCount
              : '100+' %>
          </h2>

          <p class="text-muted mb-0">
            Empresas registradas
          </p>

        </div>

      </div>


      <div class="col-6 col-lg-3">

        <div class="text-center">

          <i class="fa-solid fa-bullhorn text-success fs-1 mb-3"></i>

          <h2 class="fw-bold mb-1">
            <%= typeof applicationCount !== 'undefined'
              ? applicationCount
              : '250+' %>
          </h2>

          <p class="text-muted mb-0">
            Convocatorias publicadas
          </p>

        </div>

      </div>


      <div class="col-6 col-lg-3">

        <div class="text-center">

          <i class="fa-solid fa-user-graduate text-success fs-1 mb-3"></i>

          <h2 class="fw-bold mb-1">
            <%= typeof studentCount !== 'undefined'
              ? studentCount
              : '1,000+' %>
          </h2>

          <p class="text-muted mb-0">
            Estudiantes registrados
          </p>

        </div>

      </div>


      <div class="col-6 col-lg-3">

        <div class="text-center">

          <i class="fa-solid fa-handshake text-success fs-1 mb-3"></i>

          <h2 class="fw-bold mb-1">
            <%= typeof placementCount !== 'undefined'
              ? placementCount
              : '500+' %>
          </h2>

          <p class="text-muted mb-0">
            Conexiones profesionales
          </p>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     SOBRE LA PLATAFORMA
========================================================= -->

<section class="bg-dark text-white py-5">

  <div class="container">

    <div class="row align-items-center g-5">

      <!-- Texto -->
      <div class="col-lg-6">

        <span class="badge bg-success px-3 py-2 mb-3">
          SOBRE PRACTICA ULIMA
        </span>


        <h2 class="display-6 fw-bold mb-4">
          Tu experiencia profesional comienza aquí
        </h2>


        <p class="text-secondary lead">
          Practica Ulima es una plataforma que conecta a
          estudiantes de la Universidad de Lima con empresas
          que ofrecen oportunidades de prácticas pre-profesionales.
        </p>


        <p class="text-secondary">
          Podrás explorar convocatorias, revisar los requisitos,
          conocer las funciones del puesto y enviar tus postulaciones
          desde un solo lugar.
        </p>


        <a
          href="/como-funciona"
          class="btn btn-success mt-3">

          <i class="fa-solid fa-arrow-right me-2"></i>
          Conoce cómo funciona

        </a>

      </div>


      <!-- Características -->
      <div class="col-lg-6">

        <div class="row g-3">

          <div class="col-6">

            <div class="dark-feature-card h-100">

              <i class="fa-solid fa-filter text-success fs-1"></i>

              <h5 class="mt-3">
                Filtros inteligentes
              </h5>

              <p class="text-secondary small mb-0">
                Encuentra oportunidades según tus intereses,
                modalidad y jornada.
              </p>

            </div>

          </div>


          <div class="col-6">

            <div class="dark-feature-card h-100">

              <i class="fa-solid fa-bookmark text-success fs-1"></i>

              <h5 class="mt-3">
                Convocatorias guardadas
              </h5>

              <p class="text-secondary small mb-0">
                Guarda las oportunidades que deseas revisar
                más adelante.
              </p>

            </div>

          </div>


          <div class="col-6">

            <div class="dark-feature-card h-100">

              <i class="fa-solid fa-file-lines text-success fs-1"></i>

              <h5 class="mt-3">
                Seguimiento
              </h5>

              <p class="text-secondary small mb-0">
                Consulta el estado de tus postulaciones
                en cualquier momento.
              </p>

            </div>

          </div>


          <div class="col-6">

            <div class="dark-feature-card h-100">

              <i class="fa-solid fa-shield-halved text-success fs-1"></i>

              <h5 class="mt-3">
                Información organizada
              </h5>

              <p class="text-secondary small mb-0">
                Accede a información clara sobre empresas
                y oportunidades.
              </p>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     CTA FINAL
========================================================= -->

<section class="py-5">

  <div class="container">

    <div class="cta-section rounded-4 p-5 text-center text-white">

      <div class="mb-3">
        <i class="fa-solid fa-graduation-cap display-4"></i>
      </div>


      <h2 class="fw-bold">
        ¿Listo para comenzar tu experiencia profesional?
      </h2>


      <p class="lead mb-4">
        Regístrate y descubre nuevas oportunidades de prácticas.
      </p>


      <div class="d-flex justify-content-center flex-wrap gap-3">

        <a
          href="/register"
          class="btn btn-light btn-lg px-4">

          <i class="fa-solid fa-user-plus me-2"></i>
          Crear una cuenta

        </a>


        <a
          href="/convocatorias"
          class="btn btn-outline-light btn-lg px-4">

          <i class="fa-solid fa-bullhorn me-2"></i>
          Ver convocatorias

        </a>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     ESTILOS DEL HOME
========================================================= -->

<style>

  .min-vh-75 {
    min-height: 75vh;
  }


  .hero-section {
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(25, 135, 84, .18),
        transparent 35%
      ),
      #212529;
  }


  .hero-decoration {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }


  .hero-decoration-one {
    width: 300px;
    height: 300px;
    right: -100px;
    top: -100px;
    background: rgba(25, 135, 84, .12);
  }


  .hero-decoration-two {
    width: 220px;
    height: 220px;
    left: -100px;
    bottom: -100px;
    background: rgba(32, 201, 151, .08);
  }


  .hero-card {
    background: rgba(255, 255, 255, .08);
    border: 1px solid rgba(255, 255, 255, .15);
    border-radius: 24px;
    padding: 28px;
    backdrop-filter: blur(12px);
  }


  .hero-icon {
    width: 54px;
    height: 54px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    color: white;
    font-size: 24px;
    background: linear-gradient(135deg, #198754, #20c997);
  }


  .hero-search {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, .08);
    color: #adb5bd;
  }


  .hero-opportunity {
    padding: 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, .06);
    border: 1px solid rgba(255, 255, 255, .08);
  }


  .search-section {
    background: #f8f9fa;
  }


  .search-card {
    border-radius: 18px;
  }


  .benefit-card {
    border-radius: 18px;
    transition: all .25s ease;
  }


  .benefit-card:hover {
    transform: translateY(-6px);
  }


  .benefit-icon {
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    font-size: 24px;
  }


  .dark-feature-card {
    padding: 24px;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 18px;
    background: rgba(255, 255, 255, .04);
    transition: all .25s ease;
  }


  .dark-feature-card:hover {
    background: rgba(25, 135, 84, .12);
    transform: translateY(-4px);
  }


  .cta-section {
    background:
      linear-gradient(
        135deg,
        #198754,
        #146c43
      );
    box-shadow: 0 12px 35px rgba(25, 135, 84, .20);
  }


  @media (max-width: 767.98px) {

    .hero-section h1 {
      font-size: 2.5rem;
    }

    .cta-section {
      padding: 2rem !important;
    }

  }

</style>