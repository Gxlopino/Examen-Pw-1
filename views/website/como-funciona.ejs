<% layout("layouts/website") %>

<div class="como-funciona-page">

    <!-- Encabezado -->
    <section class="hero-como-funciona text-center">
        <div class="container">
            <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-3">
                Guía para estudiantes y empresas
            </span>

            <h1 class="fw-bold mb-3">
                ¿Cómo funciona PrácticaLima?
            </h1>

            <p class="lead text-muted mx-auto">
                Conecta con oportunidades de prácticas profesionales de forma
                sencilla, rápida y segura.
            </p>
        </div>
    </section>

    <!-- Pasos para estudiantes -->
    <section class="py-5">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Para estudiantes</h2>
                <p class="text-muted">
                    Encuentra una oportunidad que impulse tu crecimiento profesional.
                </p>
            </div>

            <div class="row g-4">

                <!-- Paso 1 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card text-center h-100">
                        <div class="step-icon">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>

                        <span class="step-number">01</span>

                        <h5 class="fw-bold mt-3">
                            Crea tu cuenta
                        </h5>

                        <p class="text-muted mb-0">
                            Regístrate en la plataforma y completa tus datos personales
                            y académicos.
                        </p>
                    </div>
                </div>

                <!-- Paso 2 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card text-center h-100">
                        <div class="step-icon">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </div>

                        <span class="step-number">02</span>

                        <h5 class="fw-bold mt-3">
                            Explora convocatorias
                        </h5>

                        <p class="text-muted mb-0">
                            Revisa las ofertas disponibles y utiliza los filtros
                            para encontrar una práctica adecuada.
                        </p>
                    </div>
                </div>

                <!-- Paso 3 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card text-center h-100">
                        <div class="step-icon">
                            <i class="fa-solid fa-file-arrow-up"></i>
                        </div>

                        <span class="step-number">03</span>

                        <h5 class="fw-bold mt-3">
                            Postula
                        </h5>

                        <p class="text-muted mb-0">
                            Revisa los requisitos de la convocatoria y envía tu
                            postulación.
                        </p>
                    </div>
                </div>

                <!-- Paso 4 -->
                <div class="col-md-6 col-lg-3">
                    <div class="step-card text-center h-100">
                        <div class="step-icon">
                            <i class="fa-solid fa-handshake"></i>
                        </div>

                        <span class="step-number">04</span>

                        <h5 class="fw-bold mt-3">
                            Inicia tu experiencia
                        </h5>

                        <p class="text-muted mb-0">
                            Si eres seleccionado, coordina con la empresa y comienza
                            tu experiencia profesional.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Proceso para empresas -->
    <section class="py-5 bg-light">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Para empresas</h2>
                <p class="text-muted">
                    Encuentra estudiantes talentosos para fortalecer tu equipo.
                </p>
            </div>

            <div class="row g-4 align-items-stretch">

                <div class="col-lg-6">
                    <div class="company-card h-100">
                        <div class="company-icon">
                            <i class="fa-solid fa-building"></i>
                        </div>

                        <h4 class="fw-bold mt-4">
                            Publica tus convocatorias
                        </h4>

                        <p class="text-muted">
                            Registra tu empresa y publica oportunidades de prácticas
                            indicando el área, los requisitos, la modalidad y los
                            beneficios ofrecidos.
                        </p>

                        <ul class="list-unstyled mt-4 mb-0">
                            <li class="mb-3">
                                <i class="fa-solid fa-check text-primary me-2"></i>
                                Registra los datos de tu empresa.
                            </li>

                            <li class="mb-3">
                                <i class="fa-solid fa-check text-primary me-2"></i>
                                Crea convocatorias detalladas.
                            </li>

                            <li class="mb-3">
                                <i class="fa-solid fa-check text-primary me-2"></i>
                                Recibe postulaciones de estudiantes.
                            </li>

                            <li>
                                <i class="fa-solid fa-check text-primary me-2"></i>
                                Selecciona al perfil más adecuado.
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="company-card h-100">
                        <div class="company-icon">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <h4 class="fw-bold mt-4">
                            Conecta con nuevos talentos
                        </h4>

                        <p class="text-muted">
                            Accede a una comunidad de estudiantes interesados en
                            desarrollar sus habilidades y adquirir experiencia
                            en el mundo laboral.
                        </p>

                        <div class="benefit-list mt-4">

                            <div class="benefit-item">
                                <i class="fa-solid fa-circle-check text-success"></i>
                                <span>Mayor visibilidad para tus ofertas.</span>
                            </div>

                            <div class="benefit-item">
                                <i class="fa-solid fa-circle-check text-success"></i>
                                <span>Proceso de búsqueda más organizado.</span>
                            </div>

                            <div class="benefit-item">
                                <i class="fa-solid fa-circle-check text-success"></i>
                                <span>Contacto con estudiantes universitarios.</span>
                            </div>

                            <div class="benefit-item">
                                <i class="fa-solid fa-circle-check text-success"></i>
                                <span>Fortalecimiento de tu equipo de trabajo.</span>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Beneficios -->
    <section class="py-5">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">¿Por qué usar PrácticaLima?</h2>
                <p class="text-muted">
                    Una plataforma pensada para facilitar el encuentro entre
                    estudiantes y empresas.
                </p>
            </div>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="benefit-card text-center h-100">
                        <i class="fa-solid fa-bolt"></i>
                        <h5 class="fw-bold mt-3">
                            Fácil y rápido
                        </h5>
                        <p class="text-muted mb-0">
                            Encuentra y publica oportunidades de manera sencilla.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="benefit-card text-center h-100">
                        <i class="fa-solid fa-filter"></i>
                        <h5 class="fw-bold mt-3">
                            Búsqueda organizada
                        </h5>
                        <p class="text-muted mb-0">
                            Filtra las convocatorias según tus intereses y necesidades.
                        </p>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="benefit-card text-center h-100">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <h5 class="fw-bold mt-3">
                            Crecimiento profesional
                        </h5>
                        <p class="text-muted mb-0">
                            Da tus primeros pasos en el mundo laboral con una práctica.
                        </p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Preguntas frecuentes -->
    <section class="py-5 bg-light">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Preguntas frecuentes</h2>
                <p class="text-muted">
                    Resolvemos algunas dudas comunes sobre la plataforma.
                </p>
            </div>

            <div class="accordion accordion-flush shadow-sm rounded-4 overflow-hidden"
                 id="faqAccordion">

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqOne">
                            ¿Quiénes pueden registrarse como estudiantes?
                        </button>
                    </h2>

                    <div id="faqOne"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Pueden registrarse estudiantes interesados en encontrar
                            oportunidades de prácticas profesionales.
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqTwo">
                            ¿Las empresas pueden publicar convocatorias?
                        </button>
                    </h2>

                    <div id="faqTwo"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Sí. Las empresas pueden registrar su información y publicar
                            convocatorias con los requisitos y detalles de cada práctica.
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqThree">
                            ¿Postular a una convocatoria tiene algún costo?
                        </button>
                    </h2>

                    <div id="faqThree"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            La plataforma está diseñada para que los estudiantes puedan
                            revisar y postular a las oportunidades disponibles sin costo.
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed"
                                type="button"
                                data-bs-toggle="collapse"
                                data-bs-target="#faqFour">
                            ¿Cómo contacto con una empresa?
                        </button>
                    </h2>

                    <div id="faqFour"
                         class="accordion-collapse collapse"
                         data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Luego de postular, la empresa podrá revisar tu información
                            y comunicarse contigo mediante los datos registrados.
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- Llamado a la acción -->
    <section class="cta-como-funciona text-center">
        <div class="container">
            <h2 class="fw-bold mb-3">
                Da el siguiente paso en tu carrera
            </h2>

            <p class="mb-4">
                Explora las convocatorias disponibles y encuentra una oportunidad
                para desarrollar tu potencial.
            </p>

            <a href="/convocatorias" class="btn btn-light btn-lg px-4">
                <i class="fa-solid fa-magnifying-glass me-2"></i>
                Ver convocatorias
            </a>
        </div>
    </section>

</div>

<style>
    .como-funciona-page {
        background-color: #ffffff;
    }

    .hero-como-funciona {
        padding: 90px 20px 75px;
        background: linear-gradient(135deg, #f1f5ff, #ffffff);
    }

    .hero-como-funciona h1 {
        font-size: 2.8rem;
        color: #172554;
    }

    .hero-como-funciona p {
        max-width: 680px;
    }

    .step-card {
        position: relative;
        padding: 30px 22px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background-color: #ffffff;
        transition: all 0.3s ease;
    }

    .step-card:hover {
        transform: translateY(-6px);
        border-color: #2563eb;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
    }

    .step-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background-color: #dbeafe;
        color: #2563eb;
        font-size: 28px;
    }

    .step-number {
        display: inline-block;
        margin-top: 18px;
        font-size: 13px;
        font-weight: 700;
        color: #2563eb;
        letter-spacing: 1px;
    }

    .step-card h5 {
        color: #1e293b;
    }

    .company-card {
        padding: 38px;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.04);
    }

    .company-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background-color: #dbeafe;
        color: #2563eb;
        font-size: 27px;
    }

    .company-card h4 {
        color: #1e293b;
    }

    .benefit-list {
        display: flex;
        flex-direction: column;
        gap: 17px;
    }

    .benefit-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #475569;
    }

    .benefit-item i {
        font-size: 18px;
    }

    .benefit-card {
        padding: 32px 25px;
        border: 1px solid #e5e7eb;
        border-radius: 18px;
        background-color: #ffffff;
    }

    .benefit-card > i {
        font-size: 32px;
        color: #2563eb;
    }

    .benefit-card h5 {
        color: #1e293b;
    }

    .accordion-button {
        padding: 22px;
        font-weight: 600;
        color: #1e293b;
    }

    .accordion-button:not(.collapsed) {
        color: #2563eb;
        background-color: #eff6ff;
        box-shadow: none;
    }

    .accordion-button:focus {
        box-shadow: none;
    }

    .accordion-body {
        line-height: 1.7;
    }

    .cta-como-funciona {
        padding: 75px 20px;
        color: #ffffff;
        background: linear-gradient(135deg, #1d4ed8, #2563eb);
    }

    .cta-como-funciona p {
        color: #dbeafe;
    }

    .cta-como-funciona .btn {
        color: #1d4ed8;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .hero-como-funciona {
            padding: 65px 20px 55px;
        }

        .hero-como-funciona h1 {
            font-size: 2.1rem;
        }

        .company-card {
            padding: 28px;
        }
    }
</style>