<style>

  .convocatorias-header {
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(25, 135, 84, .18),
        transparent 35%
      ),
      #212529;
  }


  .header-icon {
    font-size: 9rem;
    color: rgba(25, 135, 84, .45);
  }


  .filter-card,
  .opportunity-card {
    border-radius: 18px;
  }


  .opportunity-card {
    transition: all .25s ease;
  }


  .opportunity-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .08) !important;
  }


  .company-logo {
    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    flex-shrink: 0;

    border-radius: 16px;

    font-size: 1.5rem;
  }


  .company-logo-green {
    color: #198754;
    background: rgba(25, 135, 84, .12);
  }


  .company-logo-blue {
    color: #0d6efd;
    background: rgba(13, 110, 253, .12);
  }


  .company-logo-purple {
    color: #6f42c1;
    background: rgba(111, 66, 193, .12);
  }


  .company-logo-orange {
    color: #fd7e14;
    background: rgba(253, 126, 20, .12);
  }


  .company-logo-red {
    color: #dc3545;
    background: rgba(220, 53, 69, .12);
  }


  .company-logo-dark {
    color: #495057;
    background: rgba(73, 80, 87, .12);
  }


  .bookmark-btn {
