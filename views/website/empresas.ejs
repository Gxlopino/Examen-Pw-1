    </div>

  </div>

</section>



<!-- =========================================================
     ESTILOS
========================================================= -->

<style>

  .empresas-header {
    background:
      radial-gradient(
        circle at 85% 20%,
        rgba(25, 135, 84, .18),
        transparent 35%
      ),
      #212529;
  }


  .header-icon {
    font-size: 8rem;
    color: rgba(25, 135, 84, .45);
  }


  .search-card {
    border-radius: 18px;
  }


  .company-card {
    border-radius: 18px;
    transition: all .25s ease;
  }


  .company-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 .75rem 1.5rem rgba(0, 0, 0, .10) !important;
  }


  .company-logo {
    width: 62px;
    height: 62px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 16px;

    font-size: 1.6rem;
  }


  .company-logo-green {
    color: #198754;
    background: rgba(25, 135, 84, .12);
  }


  .company-logo-blue {
    color: #0d6efd;
    background: rgba(13, 110, 253, .12);
  }


  .company-logo-purple {
    color: #6f42c1;
    background: rgba(111, 66, 193, .12);
  }


  .company-logo-orange {
    color: #fd7e14;
    background: rgba(253, 126, 20, .12);
  }


  .company-logo-red {
    color: #dc3545;
    background: rgba(220, 53, 69, .12);
  }


  .company-logo-dark {
    color: #495057;
    background: rgba(73, 80, 87, .12);
  }


  .bg-purple-subtle {
    background: rgba(111, 66, 193, .12);
  }


  .text-purple {
    color: #6f42c1;
  }


  .company-info {
    border-top: 1px solid #f0f0f0;
    padding-top: 16px;
  }


  .company-cta {
    background:
      linear-gradient(
        135deg,
        #198754,
        #146c43
      );

    box-shadow: 0 12px 35px rgba(25, 135, 84, .20);
  }


  @media (max-width: 767.98px) {

    .header-icon {
      display: none;
    }

    .company-cta {
      padding: 2rem !important;
    }

  }

</style>