<!-- views/website/empresas.ejs -->

<% layout("layouts/website") %>


<!-- =========================================================
     ENCABEZADO
========================================================= -->

<section class="empresas-header bg-dark text-white py-5">

  <div class="container">

    <div class="row align-items-center">

      <div class="col-lg-8">

        <span class="badge bg-success px-3 py-2 mb-3">
          <i class="fa-solid fa-building me-2"></i>
          EMPRESAS PARTICIPANTES
        </span>

        <h1 class="display-5 fw-bold mb-3">
          Conoce las empresas
        </h1>

        <p class="lead text-secondary mb-0">
          Descubre organizaciones que buscan talento universitario
          para sus oportunidades de prácticas pre-profesionales.
        </p>

      </div>


      <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

        <i class="fa-solid fa-building-circle-check header-icon"></i>

      </div>

    </div>

  </div>

</section>



<!-- =========================================================
     BUSCADOR
========================================================= -->

<section class="py-5 bg-light">

  <div class="container">

    <div class="card border-0 shadow-sm search-card">

      <div class="card-body p-4">

        <form action="/empresas" method="GET">

          <div class="row g-3 align-items-end">

            <!-- Buscar empresa -->
            <div class="col-12 col-lg-7">

              <label class="form-label fw-semibold">
                Buscar empresa
              </label>

              <div class="input-group">

                <span class="input-group-text bg-white">
                  <i class="fa-solid fa-magnifying-glass text-success"></i>
                </span>

                <input
                  type="text"
                  name="search"
                  class="form-control"
                  placeholder="Ej. Tecnología, bancos, consultoras...">

              </div>

            </div>


            <!-- Sector -->
            <div class="col-12 col-md-6 col-lg-3">

              <label class="form-label fw-semibold">
                Sector
              </label>

              <select
                name="sector"
                class="form-select">

                <option value="">
                  Todos los sectores
                </option>

                <option value="tecnologia">
                  Tecnología
                </option>

                <option value="finanzas">
                  Finanzas
                </option>

                <option value="consultoria">
                  Consultoría
                </option>

                <option value="retail">
                  Retail
                </option>

                <option value="marketing">
                  Marketing

                </option>

              </select>

            </div>


            <!-- Botón -->
            <div class="col-12 col-md-6 col-lg-2">

              <button
                type="submit"
                class="btn btn-success w-100">

                <i class="fa-solid fa-search me-2"></i>
                Buscar

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

  </div>

</section>



