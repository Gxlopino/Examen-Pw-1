<!-- views/website/register.ejs -->

<% layout("layouts/website") %>

<section class="text-white d-flex align-items-center" 

         style="min-height: calc(100vh - 80px); background: linear-gradient(135deg, #0b0c10 0%, #12141c 100%); font-family: 'Segoe UI', system-ui, sans-serif;">

  

  <div class="container py-5">

    <div class="row justify-content-center">

      <div class="col-12 col-md-8 col-lg-5">

        

        <!-- Tarjeta de Registro Estilo Premium -->

        <div class="card border-0 shadow-lg" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 16px;">

          <div class="card-body p-4 p-sm-5">

            

            <!-- Cabecera del Formulario -->

            <div class="text-center mb-4">

              <span class="badge bg-success mb-2 px-3 py-2 text-uppercase fw-semibold" style="letter-spacing: 1px;">

                Crea tu cuenta

              </span>

              <h2 class="fw-bold text-white mt-2">

                Únete a <span class="text-success">PlayerStats</span>

              </h2>

              <p class="small text-muted mb-0">

                Guarda tus futbolistas favoritos y analiza estadísticas pro.

              </p>

            </div>

            <!-- Alerta dinámica (Oculta por defecto) -->

            <div class="alert alert-danger d-none small py-2 text-center" role="alert" id="alertMessage"></div>

            <!-- Formulario -->

            <form id="formRegister" onsubmit="registrarUsuario(event)">

              

              <!-- Nombre de Usuario -->

              <div class="mb-3">

                <label for="txtUser" class="form-label small fw-semibold text-light opacity-75">

                  Nombre de usuario

                </label>

                <div class="input-group">

                  <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #8f94a6;">

                    <i class="bi bi-person"></i>

                  </span>

                  <input type="text" class="form-control border-0 text-white" id="txtUser" placeholder="Ej. cr7_fanatic" required style="background: rgba(255,255,255,0.05); box-shadow: none;">

                </div>

              </div>

              <!-- Correo Electrónico -->

              <div class="mb-3">

                <label for="txtEmail" class="form-label small fw-semibold text-light opacity-75">

                  Correo electrónico

                </label>

                <div class="input-group">

                  <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #8f94a6;">

                    <i class="bi bi-envelope"></i>

                  </span>

                  <input type="email" class="form-control border-0 text-white" id="txtEmail" placeholder="correo@ejemplo.com" required style="background: rgba(255,255,255,0.05); box-shadow: none;">

                </div>

              </div>

              <!-- Contraseña -->

              <div class="mb-4">

                <label for="txtPassword" class="form-label small fw-semibold text-light opacity-75">

                  Contraseña

                </label>

                <div class="input-group">

                  <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #8f94a6;">

                    <i class="bi bi-lock"></i>

                  </span>

                  <input type="password" class="form-control border-0 text-white" id="txtPassword" placeholder="Mínimo 6 caracteres" required style="background: rgba(255,255,255,0.05); box-shadow: none;">

                </div>

              </div>

              <!-- Botón de Envío Interactivo -->

              <div class="d-grid mb-3">

                <button type="submit" class="btn btn-success btn-lg fw-semibold custom-submit-btn py-2">

                  <i class="bi bi-person-plus me-2"></i>Registrarse

                </button>

              </div>

            </form>

            <!-- Separador -->

            <div class="text-center my-3 position-relative">

              <hr class="border-secondary opacity-25">

              <span class="position-absolute top-50 start-50 translate-middle px-3 small text-muted" style="background: #11131a;">¿Ya eres miembro?</span>

            </div>

            <!-- Enlace a Login -->

            <div class="text-center">

              <a href="/login" class="small text-success text-decoration-none fw-semibold link-light-hover" style="transition: color 0.3s;">

                Iniciar Sesión

              </a>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

  <!-- Inyección de hojas de estilo integradas específicas para interacciones fluidas -->

  <style>

    .form-control::placeholder {

      color: rgba(255, 255, 255, 0.25) !important;

    }

    .form-control:focus {

      background: rgba(255, 255, 255, 0.08) !important;

      color: #ffffff !important;

      border: 1px solid rgba(25, 135, 84, 0.5) !important;

    }

    .custom-submit-btn {

      transition: all 0.4s ease;

      box-shadow: 0 4px 15px rgba(25, 135, 84, 0.2);

    }

    .custom-submit-btn:hover {

      transform: translateY(-2px);

      box-shadow: 0 0 20px rgba(25, 135, 84, 0.5);

    }

    .link-light-hover:hover {

      color: #ffffff !important;

    }

  </style>

  <!-- Lógica de Validación Frontend básica -->

  <script>

    function registrarUsuario(event) {

      event.preventDefault();

      

      let user = document.getElementById("txtUser").value;

      let email = document.getElementById("txtEmail").value;

      let password = document.getElementById("txtPassword").value;

      let alertBox = document.getElementById("alertMessage");

      // Validación simple en cliente

      if (password.length < 6) {

        alertBox.innerHTML = "La contraseña debe tener al menos 6 caracteres.";

        alertBox.classList.remove("d-none");

        

        setTimeout(() => {

          alertBox.classList.add("d-none");

        }, 3000);

        return;

      }

      // Aquí puedes integrar tu fetch o axios para enviar los datos a tu controlador backend

      console.log("Datos capturados:", { user, email, password });

    }

  </script>

</section>




