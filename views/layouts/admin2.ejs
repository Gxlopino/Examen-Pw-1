<!doctype html>
<html lang="es">

<head>
  <meta charset="UTF-8">

  <link rel="icon" type="image/x-icon" href="/favicon.ico">

  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <link rel="stylesheet" href="/dist/css/index.css">

  <title><%= title %></title>

  <style>

    /* =========================================
       NAVBAR ADMIN
       ========================================= */

    .admin-navbar {
      width: 100%;
      height: 52px;
      background: #202427;
      border-bottom: 1px solid #17191b;
      font-family: Arial, Helvetica, sans-serif;
    }

    .admin-navbar-container {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      padding: 0 18px;
      box-sizing: border-box;
    }


    /* =========================================
       MARCA
       ========================================= */

    .admin-brand {
      height: 100%;
      display: flex;
      align-items: center;
      text-decoration: none;
      margin-right: 24px;
      white-space: nowrap;
    }

    .brand-icon {
      width: 30px;
      height: 30px;
      background: #149b61;
      border-radius: 4px;
      margin-right: 8px;
    }

    .brand-name {
      color: #ffffff;
      font-size: 17px;
      font-weight: 700;
      letter-spacing: -0.4px;
    }

    .brand-name span {
      color: #42b87e;
    }

    .admin-badge {
      margin-left: 7px;
      padding: 3px 7px;
      background: #d9dcde;
      color: #50565b;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      line-height: 1;
    }


    /* =========================================
       MENÚ
       ========================================= */

    .admin-menu {
      height: 100%;
      display: flex;
      align-items: center;
      gap: 1px;
    }

    .admin-menu-item {
      height: 100%;
      display: flex;
      align-items: center;
      padding: 0 9px;
      border: none;
      background: transparent;
      color: #aeb4b9;
      text-decoration: none;
      font-size: 13px;
      font-weight: 400;
      cursor: pointer;
      box-sizing: border-box;
      transition: background 0.15s ease, color 0.15s ease;
    }

    .admin-menu-item:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.04);
    }


    /* =========================================
       PARTE DERECHA
       ========================================= */

    .admin-navbar-right {
      margin-left: auto;
      height: 100%;
      display: flex;
      align-items: center;
      gap: 14px;
    }


    /* =========================================
       SITIO PÚBLICO
       ========================================= */

    .public-site-btn {
      height: 30px;
      display: flex;
      align-items: center;
      padding: 0 11px;
      border: 1px solid #c8cdd0;
      border-radius: 4px;
      background: transparent;
      color: #ffffff;
      text-decoration: none;
      font-size: 12px;
      transition: background 0.15s ease;
    }

    .public-site-btn:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #ffffff;
    }


    /* =========================================
       USUARIO
       ========================================= */

    .admin-user {
      height: 100%;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #ffffff;
    }

    .user-avatar {
      width: 31px;
      height: 31px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #149b61;
      color: #ffffff;
      font-size: 13px;
      font-weight: 500;
      flex-shrink: 0;
    }

    .user-info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      line-height: 1.1;
    }

    .user-name {
      color: #ffffff;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    .user-role {
      margin-top: 3px;
      color: #8e969c;
      font-size: 10px;
      white-space: nowrap;
    }


    /* =========================================
       CERRAR SESIÓN
       ========================================= */

    .logout-btn {
      width: 22px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: transparent;
      color: #d94a65;
      font-size: 17px;
      text-decoration: none;
      cursor: pointer;
      padding: 0;
    }

    .logout-btn:hover {
      color: #f06a81;
    }


    /* =========================================
       CONTENIDO
       ========================================= */

    .admin-content {
      min-height: calc(100vh - 52px);
      padding: 20px;
      box-sizing: border-box;
    }


    /* =========================================
       RESPONSIVE
       ========================================= */

    @media (max-width: 900px) {

      .admin-navbar {
        height: auto;
        min-height: 52px;
      }

      .admin-navbar-container {
        min-height: 52px;
        height: auto;
        flex-wrap: wrap;
      }

      .admin-menu {
        width: 100%;
        height: 42px;
        overflow-x: auto;
        order: 3;
      }

      .admin-menu-item {
        height: 42px;
        white-space: nowrap;
      }

      .admin-navbar-right {
        margin-left: auto;
      }
    }


    @media (max-width: 600px) {

      .admin-navbar-container {
        padding: 0 10px;
      }

      .admin-brand {
        margin-right: 10px;
      }

      .brand-name {
        font-size: 15px;
      }

      .admin-badge {
        display: none;
      }

      .public-site-btn {
        display: none;
      }

      .user-info {
        display: none;
      }
    }

  </style>

</head>


<body>

  <!-- =========================================
       NAVBAR ADMIN
       ========================================= -->

  <nav class="admin-navbar">

    <div class="admin-navbar-container">


      <!-- =====================================
           LOGO / MARCA
           ===================================== -->

      <a href="/admin" class="admin-brand">

        <span class="brand-icon"></span>

        <span class="brand-name">
          Práctica<span>Lima</span>
        </span>

        <span class="admin-badge">
          Admin
        </span>

      </a>


      <!-- =====================================
           MENÚ
           ===================================== -->

      <div class="admin-menu">

        <a
          href="/admin"
          class="admin-menu-item"
        >
          Dashboard
        </a>

        <a
          href="/admin/semesters"
          class="admin-menu-item"
        >
          Semestres
        </a>

        <a
          href="/admin/districts"
          class="admin-menu-item"
        >
          Distritos
        </a>

        <a
          href="/admin/carrers"
          class="admin-menu-item"
        >
          Carreras
        </a>

        <a
          href="/admin/modalities"
          class="admin-menu-item"
        >
          Modalidades
        </a>

        <a
          href="/admin/skills"
          class="admin-menu-item"
        >
          Habilidades
        </a>

      </div>


      <!-- =====================================
           PARTE DERECHA
           ===================================== -->

      <div class="admin-navbar-right">


        <!-- SITIO PÚBLICO -->

        <a
          href="/"
          class="public-site-btn"
        >
          Sitio público
        </a>


        <!-- USUARIO -->

        <div class="admin-user">

          <span class="user-avatar">
            A
          </span>

          <div class="user-info">

            <span class="user-name">
              Administrador
            </span>

            <span class="user-role">
              Administrador
            </span>

          </div>

        </div>


        <!-- CERRAR SESIÓN -->

        <a
          href="/logout"
          class="logout-btn"
          title="Cerrar sesión"
        >
          ⎋
        </a>

      </div>

    </div>

  </nav>


  <!-- =========================================
       CONTENIDO EJS
       ========================================= -->

  <main class="admin-content">

    <%- body %>

  </main>


  <!-- =========================================
       JAVASCRIPT
       ========================================= -->

  <script type="module" src="/dist/js/admin.js"></script>

</body>

</html>